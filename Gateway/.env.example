# Copy this file to .env and fill in real values for your local setup.
# Gateway/config.py will refuse to start if any required value below is
# missing or invalid, and will print exactly what's wrong.

# --- MQTT broker (Mosquitto) ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC=carbon/sensor01

# --- Threshold engine (CO2 ppm) ---
CO2_WARNING_THRESHOLD=1000
CO2_CRITICAL_THRESHOLD=2000
# Number of consecutive readings past a boundary before the alert level
# actually changes (hysteresis, to stop alerts flapping near the threshold).
CO2_HYSTERESIS_READINGS=3

# --- Device status tracking ---
# Seconds of silence from a device before it's marked OFFLINE.
DEVICE_TIMEOUT_SECONDS=30

# --- MongoDB (Pipeline B: hash -> DB -> blockchain) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=carbon_emission

# --- Gateway HTTP/WebSocket server (optional, defaults shown) ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
LOG_LEVEL=INFO
